# Copy to .env for local use. Backend loads .env from the server directory or repo root.
PORT=8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TIMEOUT_MS=45000
DB_HOST=mysql-13b3d5c1-viethoan04082005-0cdd.b.aivencloud.com
DB_PORT=22489
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# VERIFY_IDENTITY validates both CA and hostname. REQUIRED alone does not.
DB_SSL_MODE=VERIFY_IDENTITY
DB_POOL_SIZE=3
# Optional: leave blank to use the Java default truststore.
DB_TRUSTSTORE_URL=
DB_TRUSTSTORE_PASSWORD=
DB_TRUSTSTORE_TYPE=PKCS12
# Docker only: optional Render text secret file containing base64 PKCS12.
DB_TRUSTSTORE_BASE64_PATH=
JWT_SECRET=
ACCESS_TOKEN_SECONDS=600
# Local HTTP only; render profile always uses Secure + SameSite=None.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
GUEST_TTL_HOURS=24
TEMPORARY_CHAT_HOURS=24
RETENTION_SCAN_MS=60000
# disabled allows text/WebRTC, attachment APIs return 503 until configured.
STORAGE_PROVIDER=disabled
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ALLOW_HTTP=false
UPLOAD_MAX_BYTES=10485760
AUDIO_MAX_SECONDS=120
FFPROBE_PATH=ffprobe
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Docker sets SPRING_PROFILES_ACTIVE=render; Render supplies PORT.
# Keep DB/JWT/storage/TURN secrets out of Git and every VITE_ variable.
