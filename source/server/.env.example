# Set these in your shell; Spring does not load .env files automatically.
PORT=8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TIMEOUT_MS=45000
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# TURN_URLS example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Keep the shared secret ONLY on the server and Coturn. Never in VITE_ variables.

# Docker/Render: set SPRING_PROFILES_ACTIVE=render (the image sets it already).
# Render provides PORT; the render profile defaults to 10000 if it is absent.
# ALLOWED_ORIGINS must be your exact frontend origin(s), e.g. https://your-app.vercel.app
# Separate origins with commas; no wildcard, trailing slash or URL path.
